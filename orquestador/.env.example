# Copia este archivo como ".env" y rellena los valores

# Token compartido entre WordPress (plugin) y este backend. Inventa uno largo.
VCC_TOKEN=pon-aqui-un-token-largo-y-secreto

# API key GRATIS de Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Token que usan los workers de Colab para auto-registrarse aquí
WORKER_TOKEN=otro-token-largo-para-el-worker

# URL PÚBLICA de este orquestador (subdominio api en Cloudflare → este VPS, puerto 8000)
# Los notebooks de Colab la usan para auto-registrarse. Ej: https://api.tudominio.com
PUBLIC_API_URL=https://api.tudominio.com

# (Opcional) fallback manual si NO usas auto-registro:
WORKER_URL=

# Contraseña de la base de datos de WordPress
DB_PASSWORD=cambia-esto
